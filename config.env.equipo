# Líneas del config.env del reto que cambian con el sistema del equipo.
# instalar_en_placa.sh pone LLM_FILE y LLM_ALIAS solo; el resto del config.env del reto no se toca
# (llama.cpp 2cbe0ec, LLM_PORT=8081, LLM_CTX=4096, LLM_THREADS=4, TIME_LIMIT_SECONDS=60, SEED=42).

# Modelo: media de los pesos de 10 Qwen3-1.7B con LoRA r32, GGUF Q8_0 (1.834.426.208 bytes)
LLM_REPO=https://github.com/Arnau000z/placa-velocidad/releases/tag/modelo-final
LLM_REVISION=modelo-final
LLM_FILE=sopa_z10-Q8_0.gguf
LLM_SHA256=2629538b96ec41453b74d85ae5047acd1655ff7bcd85b2bd2bdc81d51297b5f9
LLM_ALIAS=equipo
# md5 c1ba1d47e8f818378e27be6a7c1a01b2 (el que comprueba instalar_en_placa.sh)

# Embeddings: los del reto (bge-small). Nuestro predict.py no los usa, pero el servicio math-embed sigue instalado.
